{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "agent": {
    "plan": {
      "model": "openai/gpt-5.5",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "build": {
      "model": "openai/gpt-5.5",
      "reasoningEffort": "medium",
      "textVerbosity": "low"
    }
  },
  "skills": {
    "paths": [".agents/skills"]
  },
  "mcp": {
    "openpencil": {
      "type": "remote",
      "url": "http://127.0.0.1:3100/mcp",
      "enabled": true,
      "timeout": 30000
    }
  }
}
