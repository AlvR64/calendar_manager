@baseUrl = http://localhost:5167
@adminAccessToken = paste-admin-access-token-here
@businessId = paste-business-id-here
@businessSlug = barberia-centro-madrid
@serviceId = paste-service-id-here
@staffMemberId = paste-staff-member-id-here

### Health check
GET {{baseUrl}}/health
Accept: application/json

###

### Get business by ID
GET {{baseUrl}}/api/businesses/{{businessId}}

###

### Get business profile by ID
GET {{baseUrl}}/api/businesses/{{businessId}}/profile

###

### Get business profile by slug
GET {{baseUrl}}/api/businesses/by-slug/{{businessSlug}}/profile

###

### List business services
GET {{baseUrl}}/api/businesses/{{businessId}}/services

###

### Get business service
GET {{baseUrl}}/api/businesses/{{businessId}}/services/{{serviceId}}

###

### List business staff members
GET {{baseUrl}}/api/businesses/{{businessId}}/staff-members

###

### Get business staff member
GET {{baseUrl}}/api/businesses/{{businessId}}/staff-members/{{staffMemberId}}

###

### Update current business details
PUT {{baseUrl}}/api/businesses/current
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "name": "Barberia Centro",
  "description": "Barberia clasica en Madrid",
  "contactEmail": "contacto@barberia-centro.test",
  "contactPhoneNumber": "+34910000000",
  "websiteUrl": "https://barberia-centro.test",
  "addressLine1": "Calle Mayor 1",
  "addressLine2": null,
  "city": "Madrid",
  "postalCode": "28013",
  "countryCode": "ES",
  "timeZoneId": "Europe/Madrid",
  "currencyCode": "EUR"
}

###

### Update current business booking window
PUT {{baseUrl}}/api/businesses/current/booking-window
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "maxAdvanceBookingDays": 60
}

###

### Create service
POST {{baseUrl}}/api/services
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "name": "Corte de pelo",
  "description": "Corte clasico o moderno",
  "durationMinutes": 30,
  "priceAmount": 18.00,
  "sortOrder": 0
}

###

### Create staff member
POST {{baseUrl}}/api/staff-members
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "displayName": "Laura Martinez",
  "email": "laura@example.test",
  "phoneNumber": "+34600999888",
  "bio": "Especialista en cortes y color",
  "sortOrder": 0
}

###

### Assign service to staff member
POST {{baseUrl}}/api/staff-members/{{staffMemberId}}/services/{{serviceId}}
Authorization: Bearer {{adminAccessToken}}

###

### Assign staff member to service
POST {{baseUrl}}/api/services/{{serviceId}}/staff-members/{{staffMemberId}}
Authorization: Bearer {{adminAccessToken}}

###

### Login admin
POST {{baseUrl}}/api/auth/admin/login
Content-Type: application/json

{
  "email": "admin@barberia-centro.test",
  "password": "ChangeMe123!"
}

###

### Login customer
POST {{baseUrl}}/api/auth/customer/login
Content-Type: application/json

{
  "email": "customer@example.test",
  "password": "ChangeMe123!"
}

###

### Register business with initial admin
POST {{baseUrl}}/api/auth/register-business
Content-Type: application/json

{
  "businessName": "Barberia Centro",
  "businessSlug": "barberia-centro",
  "timeZoneId": "Europe/Madrid",
  "currencyCode": "EUR",
  "adminEmail": "admin@barberia-centro.test",
  "adminPassword": "ChangeMe123!",
  "adminDisplayName": "Admin Centro"
}

###

### Register customer
POST {{baseUrl}}/api/auth/register-customer
Content-Type: application/json

{
  "email": "customer@example.test",
  "password": "ChangeMe123!",
  "firstName": "Carlos",
  "lastName": "Garcia",
  "phoneNumber": "+34600111222"
}

###
